<resources>
    <!-- Base application theme. -->
    <style name="Theme.PesagemModular" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorPrimaryVariant">@color/dark_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="card_item_unit">@drawable/custom_layout_spinner_light</item>
    </style>

    <style name="BlueButton" parent="Theme.PesagemModular">
        <item name="color">@color/dark_blue</item>
        <item name="android:textSize">@dimen/big_font</item>
        <item name="android:gravity">center</item>
        <item name="textAllCaps">false</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">55dp</item>
    </style>

    <style name="TitleTextView" parent="Theme.PesagemModular">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/extra_big_fonf</item>
<!--        <item name="android:layout_marginTop">@dimen/extra_small_margin</item>-->
<!--        <item name="android:layout_marginStart">@dimen/big_margin</item>-->
<!--        <item name="android:layout_marginEnd">@dimen/big_margin</item>-->
    </style>

    <attr name="card_item_unit" format="reference" />

    <style name="ItemTextView" parent="Theme.PesagemModular">
        <item name="android:ellipsize">marquee</item>
        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:textSize">@dimen/extra_big_fonf</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="textHintAppearance" parent="Theme.PesagemModular">
        <item name="android:textColorHint">@color/dark_blue</item>
        <item name="hintTextColor">@color/dark_blue</item>
    </style>

    <style name="report_text">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="report_title">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="report_big_title">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>