<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="br.com.backupautomacao.pesagem_modular.ui.fragments.SaleForUnitFragment">

    <data>

        <variable
            name="viewModel"
            type="br.com.backupautomacao.pesagem_modular.ui.viewmodel.SaleForUnitViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/spinnerLoading"
            layout="@layout/loading_dialog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="250dp"
            android:layout_marginVertical="90dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout2"
                style="@style/textHintAppearance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="130dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/card_item_unit"
                    android:hint="@string/placeholder_input_text"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textSize="20sp"
                    tools:text="TESTE" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout3"
                style="@style/textHintAppearance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="@dimen/default_margin"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout5">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLabelQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/card_item_unit"
                    android:hint="@string/insert_label_quantity"
                    android:inputType="numberDecimal"
                    tools:text="TESTE"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout5"
                style="@style/textHintAppearance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="@dimen/default_margin"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/card_item_unit"
                    android:digits="0123456789.,"
                    android:hint="@string/insert_product_quantity"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textSize="20sp"
                    tools:text="TESTE" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="108dp"
                android:layout_marginEnd="@dimen/big_margin"
                android:background="?attr/card_item_unit"
                android:paddingHorizontal="@dimen/small_margin"
                android:paddingVertical="@dimen/big_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView12"
                    style="@style/TitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/small_margin"
                    android:text="@string/text_title_barcode"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvProductCode"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textView13"
                    style="@style/TitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/small_margin"
                    android:text="@string/text_title_description"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvProductDescription"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textView14"
                    style="@style/TitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/small_margin"
                    android:text="@string/text_title_price"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvProductPrice"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvProductCode"
                    style="@style/ItemTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:ellipsize="marquee"
                    android:text="@{viewModel.mgvProduct.code}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/textView12"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="TESTESTESTESTES" />

                <TextView
                    android:id="@+id/tvProductDescription"
                    style="@style/ItemTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="60dp"
                    android:maxEms="10"
                    android:text="@{viewModel.mgvProduct.description}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/textView13"
                    app:layout_constraintTop_toBottomOf="@+id/tvProductCode"
                    tools:text="TESTESTESTEST" />

                <TextView
                    android:id="@+id/tvProductPrice"
                    style="@style/ItemTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="56dp"
                    android:ellipsize="marquee"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.539"
                    app:layout_constraintStart_toEndOf="@+id/textView14"
                    app:layout_constraintTop_toBottomOf="@+id/tvProductDescription"
                    app:productPrice="@{viewModel.mgvProduct.price}"
                    tools:text="R$ 999,99" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/printButton"
                style="@style/BlueButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="@dimen/default_margin"
                android:text="@string/text_button_print"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout3" />


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="442dp" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>