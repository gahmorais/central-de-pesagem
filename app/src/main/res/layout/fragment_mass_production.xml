<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="br.com.backupautomacao.centraldepesagem.ui.fragments.MassProductionFragment">

    <data>
        <variable
            name="viewModel"
            type="br.com.backupautomacao.centraldepesagem.ui.viewmodel.MassProductionViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/spinnerLoading"
            layout="@layout/loading_dialog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="250dp"
            android:layout_marginVertical="90dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#ccc"
            android:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="130dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/custom_layout_spinner"
                    android:hint="@string/placeholder_input_text"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botões de modo: Quantidade / Peso -->
            <LinearLayout
                android:id="@+id/layoutToggleButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@id/textInputLayout2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                android:layout_marginHorizontal="@dimen/big_margin">

                <Button
                    android:id="@+id/btnQuantityMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Por Quantidade" />

                <Button
                    android:id="@+id/btnWeightMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Por Peso" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="@dimen/default_margin"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout5">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLabelQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/custom_layout_spinner"
                    android:hint="@string/insert_label_quantity"
                    android:inputType="numberDecimal"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="@dimen/default_margin"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutToggleButtons">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/custom_layout_spinner"
                    android:digits="0123456789.,"
                    android:hint="@string/insert_label_weight"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Informações do Produto -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="110dp"
                android:layout_marginEnd="@dimen/big_margin"
                android:background="@drawable/custom_layout_spinner"
                android:paddingHorizontal="@dimen/small_margin"
                android:paddingVertical="@dimen/big_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView12"
                    style="@style/TitleTextView"
                    android:layout_marginStart="@dimen/small_margin"
                    android:text="@string/text_title_barcode"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvProductCode"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textView13"
                    style="@style/TitleTextView"
                    android:layout_marginStart="@dimen/small_margin"
                    android:text="@string/text_title_description"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvProductDescription"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textView14"
                    style="@style/TitleTextView"
                    android:layout_marginStart="@dimen/small_margin"
                    android:text="@string/text_title_price"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvProductPrice"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvProductCode"
                    style="@style/ItemTextView"
                    android:layout_marginStart="50dp"
                    android:text="@{viewModel.mgvProduct.code}"
                    app:layout_constraintStart_toEndOf="@+id/textView12"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvProductDescription"
                    style="@style/ItemTextView"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="60dp"
                    android:maxEms="10"
                    android:text="@{viewModel.mgvProduct.description}"
                    app:layout_constraintStart_toEndOf="@+id/textView13"
                    app:layout_constraintTop_toBottomOf="@+id/tvProductCode" />

                <TextView
                    android:id="@+id/tvProductPrice"
                    style="@style/ItemTextView"
                    android:layout_marginStart="75dp"
                    android:layout_marginTop="60dp"
                    app:layout_constraintStart_toEndOf="@+id/textView14"
                    app:layout_constraintTop_toBottomOf="@+id/tvProductDescription"
                    app:productPrice="@{viewModel.mgvProduct.price}" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <Button
                android:id="@+id/printButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="@dimen/default_margin"
                android:text="@string/text_button_print"
                android:textSize="@dimen/big_font"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout3" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="442dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>












