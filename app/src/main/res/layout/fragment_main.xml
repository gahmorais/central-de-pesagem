<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragments.MainFragment">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="br.com.backupautomacao.pesagem_modular.ui.viewmodel.MainViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/spinnerLoading"
            layout="@layout/loading_dialog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="250dp"
            android:layout_marginVertical="90dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="54dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="@dimen/big_margin"
                android:layout_marginEnd="256dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputProductCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/placeholder_input_text"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <Spinner
                android:id="@+id/spinnerScale"
                style="@style/ItemTextView"
                android:background="@drawable/custom_layout_spinner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView8"
                style="@style/TitleTextView"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="100dp"
                android:layout_marginTop="@dimen/extra_small_margin"
                android:gravity="end"
                android:text="@string/text_title_select_scale"
                android:textColor="@color/black"
                android:textSize="30sp"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView2"
                style="@style/TitleTextView"
                android:text="@string/text_title_barcode"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView8" />

            <TextView
                android:id="@+id/productCode"
                style="@style/ItemTextView"
                android:layout_marginTop="4dp"
                android:text="@{viewModel.mgvProduct.code}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/textView8"
                tools:text="@string/placeholder_product_code" />

            <TextView
                android:id="@+id/textView"
                style="@style/TitleTextView"
                android:text="@string/text_title_description"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />

            <TextView
                android:id="@+id/productDescription"
                style="@style/ItemTextView"
                android:text="@{viewModel.mgvProduct.description}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/productCode"
                tools:text="@string/placeholder_description" />

            <TextView
                android:id="@+id/textView3"
                style="@style/TitleTextView"
                android:text='@{viewModel.showQuantity ? "Preço / UN" : "Preço / KG"}'
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView13"
                tools:text="@string/placeholder_unit_price" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/big_margin"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/extra_big_margin"
                android:visibility="@{viewModel.showQuantity ? View.VISIBLE : View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/productPrice"
                tools:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:hint="Digite a quantidade"
                    android:inputType="number"
                    android:text="@={viewModel.quantity}" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textView4"
                style="@style/TitleTextView"
                android:text='@{viewModel.showQuantity ? "Quantidade" : @string/text_title_weight}'
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView3" />

            <TextView
                android:id="@+id/textView6"
                style="@style/TitleTextView"
                android:text="@string/text_title_price"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView4" />

            <TextView
                android:id="@+id/productPrice"
                style="@style/ItemTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/textView14"
                app:productPrice="@{viewModel.mgvProduct.price}"
                tools:text="@string/placeholder_price" />


            <TextView
                android:id="@+id/textView5"
                style="@style/ItemTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/productPrice"
                app:productWeight="@{viewModel.mgvProduct.weight}" />

            <TextView
                android:id="@+id/textView10"
                style="@style/ItemTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/textView5"
                app:productPrice="@{viewModel.mgvProduct.totalPrice}"
                tools:text="@string/placeholder_price" />

            <Button
                android:id="@+id/buttonWeighing"
                style="@style/BlueButton"

                android:text="@string/text_button_weighing"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/textView10" />

            <Button
                android:id="@+id/buttonPrint"
                style="@style/BlueButton"
                android:text="@string/text_button_print"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/buttonWeighing" />

            <Button
                android:id="@+id/buttonUnitType"
                style="@style/BlueButton"
                android:text='@{viewModel.showQuantity ? "Preço / KG" : "Preço / UN"}'
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView6"
                tools:text="Preço / UN" />


            <Button
                android:id="@+id/buttonTare"
                style="@style/BlueButton"
                android:text="@string/text_button_tare"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/textView6"
                tools:text="Limpar tara" />

            <Button
                android:id="@+id/buttonLoadPrice"
                style="@style/BlueButton"
                android:text="@string/text_button_load_price"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/buttonTare" />

            <Button
                android:id="@+id/buttonBlockProduct"
                style="@style/BlueButton"
                android:text="@string/text_block_product"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonUnitType"
                tools:text="Desfixar produto" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.33" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.66" />

            <TextView
                android:id="@+id/textView13"
                style="@style/TitleTextView"
                android:text="@string/placeholder_tare"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView" />

            <TextView
                android:id="@+id/textView14"
                style="@style/ItemTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guideline3"
                app:layout_constraintTop_toBottomOf="@+id/productDescription"
                app:productTare="@{viewModel.currentTare}"
                tools:text="999,99Kg" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>