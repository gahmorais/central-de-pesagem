<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragments.MainFragment">
    <data>
        <variable
            name="viewModel"
            type="br.com.backupautomacao.centraldepesagem.ui.viewmodel.MainFragmentViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/spinnerLoading"
            layout="@layout/loading_dialog"
            android:visibility="gone"
            android:layout_height="0dp"
            android:layout_width="0dp"
            android:layout_marginHorizontal="250dp"
            android:layout_marginVertical="90dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">


            <TextView
                android:id="@+id/textView"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:textColor="@color/black"
                android:layout_marginStart="@dimen/big_margin"
                android:layout_marginTop="88dp"
                android:text="@string/text_title_description"
                android:textSize="35sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="4dp"
                android:textColor="@color/black"
                android:text="@string/text_title_price_per_kilo"
                android:textSize="35sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/productPrice"
                app:layout_constraintStart_toStartOf="@+id/guideline4"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <TextView
                android:id="@+id/productCode"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:paddingStart="@dimen/default_margin"
                android:layout_marginStart="2dp"
                android:text="@{viewModel.mgvProduct.code}"
                android:textSize="35sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/textView2"
                app:layout_constraintEnd_toStartOf="@+id/guideline4"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/textView2"
                tools:text="23" />

            <TextView
                android:id="@+id/productPrice"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:paddingStart="@dimen/default_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/extra_big_margin"
                android:textSize="35sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView3"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout"
                app:productPrice="@{viewModel.mgvProduct.price}"
                tools:text="R$ 222,00" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:textColor="@color/black"
                android:layout_marginStart="@dimen/big_margin"
                android:layout_marginTop="161dp"
                android:text="@string/text_title_weight"
                android:textSize="35sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="161dp"
                android:text="@string/text_title_price"
                android:textColor="@color/black"
                android:textSize="35sp"
                app:layout_constraintStart_toStartOf="@+id/guideline4"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:textColor="@color/black"
                android:layout_marginStart="@dimen/big_margin"
                android:layout_marginTop="16dp"
                android:text="@string/text_title_barcode"
                android:textSize="35sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <TextView
                android:id="@+id/productDescription"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:paddingStart="@dimen/default_margin"
                tools:text="BACON MANTA RIO SUL"
                android:layout_marginEnd="@dimen/extra_big_margin"
                android:text="@{viewModel.mgvProduct.description}"
                android:textSize="35sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/textView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.177"
                app:layout_constraintStart_toEndOf="@+id/textView" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:textSize="35sp"
                tools:text="1,000 Kg"
                android:paddingStart="@dimen/default_margin"
                app:layout_constraintBaseline_toBaselineOf="@+id/textView4"
                app:layout_constraintEnd_toStartOf="@+id/guideline4"
                app:layout_constraintStart_toEndOf="@+id/textView4"
                app:productWeight="@{viewModel.mgvProduct.weight}" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="0dp"
                android:layout_height="50dp"
                tools:text="R$ 222,00"
                android:paddingStart="@dimen/default_margin"
                android:layout_marginEnd="@dimen/extra_big_margin"
                android:textSize="35sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/textView6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView6"
                app:productPrice="@{viewModel.mgvProduct.totalPrice}" />

            <Button
                android:id="@+id/buttonWeighing"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="241dp"
                android:text="@string/text_button_weighing"
                app:layout_constraintStart_toStartOf="@+id/guideline4"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <Button
                android:id="@+id/buttonPrint"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="47dp"
                android:layout_marginEnd="@dimen/extra_big_margin"
                android:layout_marginTop="241dp"
                android:text="@string/text_button_print"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/buttonWeighing"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/big_margin"
                app:layout_constraintEnd_toStartOf="@+id/linearLayout6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputProductCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/placeholder_input_text"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonFixProduct"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginStart="32dp"
                android:layout_marginTop="240dp"
                android:text="@string/text_button_fix_product"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <Button
                android:id="@+id/buttonLoadPrice"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="@dimen/big_margin"
                android:layout_marginTop="241dp"
                android:width="0dp"
                android:text="@string/text_button_load_price"
                app:layout_constraintEnd_toStartOf="@+id/guideline4"
                app:layout_constraintStart_toEndOf="@+id/buttonFixProduct"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="466dp" />

            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="110dp"
                android:layout_height="50dp"
                android:layout_marginEnd="@dimen/extra_big_margin"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:text="Status"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/bluetoothStatus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/dark_red" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>